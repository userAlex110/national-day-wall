# 依赖与构建产物
node_modules/
dist/

# npm run devices 生成的截图与对照页（7MB 上下，每次重跑都会变）
preview/

# Wrangler / Cloudflare 本地状态
.wrangler/
.dev.vars
.og.tmp.svg

# 真实照片：体积大，而且是各人自己的东西，不该跟着代码走。
#
# 两条分开写是有意的：
#   /photos/         你丢进去的相机原图（5MB+，还带 EXIF）
#   /public/photos/  npm run photos 从原图转出来的 webp/svg 派生图
#
# 派生图其实只有 860KB，想让仓库自包含、clone 下来直接 build 出成品墙的话，
# 可以把下面第二条换成：
#     /public/photos/*
#     !/public/photos/p*.svg      ← 只留占位图
# 但那样别人 fork 之后看到的会是**你的照片**，做模板仓库时不要这么干。
/photos/
/public/photos/

# photos.json 是 npm run photos / npm run demo 生成的，跟着照片走。
# 不写这一条的话，别人 clone 下来会拿到一份指向「不存在的图片」的清单，
# 打开就是一面裂图。缺文件时 scripts/ensure-photos.mjs 会自动铺一面占位墙。
/src/data/photos.json

# 各人自己写的文案（白条短句 + 背面故事）。
# 不进库有两个原因：一是有私人内容（写了在哪儿拍的），
# 二是 README 让人把照片命名成 1x / 2x —— 留在这里的话，
# 别人 fork 之后他们自己那张 1x 会莫名其妙被配上你的文案。
# 没有这个文件时 prepare-photos.mjs 会把文案留空，不会报错。
/captions.json

# 分享卡片（npm run og 生成）。**它里面印着照片本身**，所以也不进库。
# 缺了会被 scripts/ensure-photos.mjs 用占位墙重新生成一张。
/public/og.jpg

# prepare-photos.mjs 的增量缓存：记的是本机文件的 mtime + size，
# 换台机器就完全失效，不该进版本库
.cache.json

# 系统
.DS_Store
*.log
